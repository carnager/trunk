# Content search and face vectors for new photos, next to trunk on the same machine.
# Runs as the trunk user, from trunk-ai.timer. The Arch package installs both; then once, in a
# terminal (asks for the password, remembers the login, downloads the models):
#   sudo -u trunk TRUNK_AI_MODELS=/var/lib/trunk/ai-models trunk-ai index -server http://127.0.0.1:8420 -user ADMIN
# set TRUNK_USER=ADMIN in /etc/trunk/trunk-ai.env, then: sudo systemctl enable --now trunk-ai.timer
#
# Needs the ONNX Runtime library (Arch: onnxruntime-cpu). About 1 GB of models in
# /var/lib/trunk/ai-models and under 1 GB of memory while it runs.

[Unit]
Description=trunk-ai: content search vectors for new photos
After=trunk.service
Wants=trunk.service

[Service]
Type=oneshot
User=trunk
Group=trunk
Environment=TRUNK_SERVER=http://127.0.0.1:8420
Environment=TRUNK_AI_MODELS=/var/lib/trunk/ai-models
EnvironmentFile=-/etc/trunk/trunk-ai.env
Environment=HOME=/var/lib/trunk
ExecStart=/usr/bin/trunk-ai index -batch 16 -threads 2

# Behind trunk: low priority, at most two cores, so photos keep loading quickly.
Nice=15
IOSchedulingClass=idle
CPUQuota=200%

ProtectSystem=strict
ReadWritePaths=/var/lib/trunk
ProtectHome=true
PrivateTmp=true
NoNewPrivileges=true
