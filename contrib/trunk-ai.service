# Content search vectors for new photos, next to trunk on the same machine.
# Runs as the trunk user, from trunk-ai.timer. Install:
#   sudo install -m 755 ai/trunk-ai /usr/local/bin/trunk-ai
#   sudo cp contrib/trunk-ai.service contrib/trunk-ai.timer /etc/systemd/system/
#   sudo -u trunk TRUNK_AI_MODELS=/var/lib/trunk/ai-models trunk-ai index -server http://127.0.0.1:8420 -user ADMIN
#       (once, in a terminal: asks for the password, remembers the login, downloads the models)
#   edit ADMIN below, then: sudo systemctl enable --now trunk-ai.timer
#
# Needs the ONNX Runtime library (Arch: onnxruntime-cpu). About 1 GB of models in
# /var/lib/trunk/ai-models and under 1 GB of memory while it runs.

[Unit]
Description=trunk-ai: content search vectors for new photos
After=trunk.service
Wants=trunk.service

[Service]
Type=oneshot
User=trunk
Group=trunk
Environment=TRUNK_AI_MODELS=/var/lib/trunk/ai-models
Environment=HOME=/var/lib/trunk
ExecStart=/usr/local/bin/trunk-ai index -server http://127.0.0.1:8420 -user ADMIN -batch 16 -threads 2

# Behind trunk: low priority, at most two cores, so photos keep loading quickly.
Nice=15
IOSchedulingClass=idle
CPUQuota=200%

ProtectSystem=strict
ReadWritePaths=/var/lib/trunk
ProtectHome=true
PrivateTmp=true
NoNewPrivileges=true
